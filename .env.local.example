# ── Image generation ─────────────────────────────────────────────────────────
# If set, the /api/generate-image route calls OpenAI gpt-image-1 (recommended).
# Without this, it falls back to the free Pollinations API (good for local dev).
OPENAI_API_KEY=

# ── Cloudinary (optional but recommended for permanent image URLs) ────────────
# If set, generated images are uploaded to Cloudinary and stable URLs are returned.
CLOUDINARY_CLOUD_NAME=
CLOUDINARY_API_KEY=
CLOUDINARY_API_SECRET=

# ── Email capture / ESP ───────────────────────────────────────────────────────
# Pick one. Set the corresponding key and update /api/capture/route.ts.
MAILCHIMP_API_KEY=
MAILCHIMP_LIST_ID=
MAILCHIMP_SERVER=       # e.g. us1

KLAVIYO_API_KEY=
KLAVIYO_LIST_ID=

# ── Pietra ────────────────────────────────────────────────────────────────────
# The real product/checkout URL from your Pietra account.
NEXT_PUBLIC_PIETRA_URL=https://www.pietra.com/your-product-link
